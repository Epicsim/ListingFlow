# ListingFlow configuration. Copy to .env.local and fill in what you need.
# Never commit .env.local - it is gitignored.

# --- Product ------------------------------------------------------------------
# Product name shown across the app (default: ListingFlow).
NEXT_PUBLIC_APP_NAME=ListingFlow
# Public URL of the app. Used for share links and links inside emails.
# Recommended in production so a spoofed Host header can't change them.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Business details shown in the site footer and the legal pages (Privacy, Terms,
# Cookies, Refunds). Set them before launch; placeholders are shown until you do.
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_EMAIL=

# --- Backend ------------------------------------------------------------------
# "local"    = embedded database in ./.data + development-only sign-in (no accounts needed)
# "supabase" = Supabase Auth + Supabase Postgres (use this for any real deployment)
# If unset: "supabase" when NEXT_PUBLIC_SUPABASE_URL is set, otherwise "local".
LISTINGFLOW_BACKEND=local

# Signs form tokens and local sessions and keys the rate-limit hash.
# Required in Supabase mode (at least 32 characters). Generate: openssl rand -base64 48
# In local mode one is generated automatically in .data/app-secret.
APP_SECRET=

# --- Supabase (required when LISTINGFLOW_BACKEND=supabase) ----------------------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings > Database > Connection string > Transaction pooler (port 6543).
# Server-only secret: it is never sent to the browser. Example shape:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=
# Optional: max pooled connections per server instance (default 5).
# DATABASE_POOL_MAX=5

# --- Email (optional) -----------------------------------------------------------
# Emails are saved to the in-app Outbox as previews and NOT sent unless all
# three are set. Keep this off during development.
EMAIL_DELIVERY=preview
# RESEND_API_KEY=
# Must use a domain you have verified with Resend.
# EMAIL_FROM="Jordan Rivera <notifications@your-domain.com>"

# --- Daily digest ---------------------------------------------------------------
# Vercel sends this as Authorization: Bearer <secret> to the daily cron route.
CRON_SECRET=
# Optional local-hour threshold (0–23). Leave unset with the Hobby daily schedule.
# For Pro, use an hourly cron and set DIGEST_LOCAL_HOUR=7.
# DIGEST_LOCAL_HOUR=

# --- Stripe subscriptions -------------------------------------------------------
# disabled (default), test (Stripe sandbox), or live (real charges, Supabase + HTTPS only).
BILLING_MODE=disabled
# Server-only. Use matching test/live keys; no publishable key is needed for hosted Checkout.
# Prefer a restricted API key (rk_test_ / rk_live_); secret keys (sk_) also work.
STRIPE_SECRET_KEY=
# A recurring monthly USD 20.00 Price, with interval_count=1 and quantity=1.
STRIPE_PRICE_ID=
# Signing secret for /api/stripe/webhook (Stripe CLI's secret for local testing).
STRIPE_WEBHOOK_SECRET=
# Optional: billing portal configuration from `npm run billing:setup`.
STRIPE_PORTAL_CONFIGURATION_ID=

# --- Local mode (optional) ------------------------------------------------------
# Where local data is stored (default: ./.data).
# LOCAL_DATA_DIR=./.data
